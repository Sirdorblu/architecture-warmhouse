1.команда отопления
@startuml
autonumber
actor User as U
participant "Web App" as WEB
participant "BFF" as BFF
participant "IAM" as IAM
participant "Heating Service" as HEAT
database "Heating DB" as HDB
queue "Event Bus" as BUS
participant "Device Gateway" as GW
entity "Heating Device" as DEV

U -> WEB:setTargetTemperature()
WEB -> BFF: POST /heating/commands {JWT}
BFF -> IAM: validate(JWT)
IAM --> BFF: OK
BFF -> HEAT:createCommand(deviceId,payload)
HEAT -> HDB: save(Command{PENDING})
HEAT -> BUS:publish(DeviceCommand)
BUS -> GW: consume(DeviceCommand)
GW -> DEV:MQTT publish cmd
DEV --> GW:ACK/state
GW -> BUS: publish(CmdAck/State)
BUS -> HEAT: consume(CmdAck/State)
HEAT -> HDB:update(Command{APPLIED})
HEAT --> BFF:202 Accepted, commandId
BFF --> WEB:commandId
@enduml

